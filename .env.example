# Все переменные необязательны. На GitHub Pages задаются в
# Settings → Secrets and variables → Actions → Variables.

# Путь, под которым опубликован сайт. Для GitHub Pages: /sumka-raffia, для своего домена — пусто.
NEXT_PUBLIC_BASE_PATH=/sumka-raffia
# Публичный адрес сайта (для SEO, Open Graph, sitemap).
NEXT_PUBLIC_SITE_URL=https://sfocus92.github.io/sumka-raffia
# Номер WhatsApp — если задан, на сайте появятся ссылки на WhatsApp.
NEXT_PUBLIC_WHATSAPP=
# URL обработчика форм (например, https://formspree.io/f/xxxx). Если пусто —
# заявка открывается в Telegram с готовым текстом.
NEXT_PUBLIC_ORDER_ENDPOINT=
